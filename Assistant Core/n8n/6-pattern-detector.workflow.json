          }
        ]
      ]
    },
    "Compose Request": {
      "main": [
        [
          {
            "node": "Claude - Detect Patterns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude - Detect Patterns": {
      "main": [
        [
          {
            "node": "Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Output": {
      "main": [
        [
          {
            "node": "Update Patterns File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/London"
  },
  "pinData": {}
}