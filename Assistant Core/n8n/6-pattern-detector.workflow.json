{
  "name": "JARVIS - Pattern Detector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "pd1",
      "name": "Every Monday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "list",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "JARVIS/Inbox"
      },
      "id": "pd2",
      "name": "List Inbox",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const N = 30;\nconst files = $input.all().map(i => i.json)\n  .filter(f => f.type === 'file' && String(f.name).endsWith('.md'))\n  .sort((a, b) => String(b.name).localeCompare(String(a.name)))\n  .slice(0, N);\nif (files.length === 0) {\n  return [{ json: { path: 'Claude Memory/capture_queue.md', name: 'capture_queue.md' } }];\n}\nreturn files.map(f => ({ json: { path: f.path, name: f.name } }));"
      },
      "id": "pd3",
      "name": "Pick Recent Captures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "={{ $json.path }}",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "id": "pd4",
      "name": "Get Capture File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const parts = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const name = j.name || j.path || 'file';\n  let text = '';\n  if (j.content) text = Buffer.from(j.content, 'base64').toString('utf8');\n  parts.push('## ' + name + '\\n' + text.slice(0, 4000));\n}\nreturn [{ json: { corpus: parts.join('\\n\\n---\\n\\n').slice(0, 45000) } }];"
      },
      "id": "pd5",
      "name": "Aggregate Captures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "Claude Memory/patterns.md",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "id": "pd6",
      "name": "Get Current Patterns",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const captures = $('Aggregate Captures').first().json.corpus;\nlet previous = '';\nconst prev = $input.first().json;\nif (prev && prev.content) previous = Buffer.from(prev.content, 'base64').toString('utf8').slice(0, 5000);\nconst today = $now.setZone('Europe/London').toFormat('yyyy-MM-dd');\nconst body = {\n  model: 'claude-opus-4-8',\n  max_tokens: 2000,\n  system: 'You are JARVIS, a pattern analyst for Elliot. Analyse the past week of captures (today is ' + today + '; filenames contain dates - weight the last 7 days). Sections: ## Capture Timing, ## Action Patterns, ## Decision Patterns, ## Behavioural Patterns, ## Insights, ## Next Week Suggestion. Compare against the previous report where relevant. Only use evidence from the provided captures.',\n  messages: [{ role: 'user', content: '=== CAPTURES ===\\n' + captures + '\\n\\n=== PREVIOUS PATTERNS REPORT (comparison) ===\\n' + previous + '\\n\\nGenerate this week\\'s pattern report.' }]\n};\nreturn [{ json: { body } }];"
      },
      "id": "pd7",
      "name": "Compose Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "pd8",
      "name": "Claude - Detect Patterns",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text;\nconst date = $now.setZone('Europe/London').toFormat('yyyy-MM-dd');\nlet previous = '';\nconst prev = $('Get Current Patterns').first().json;\nif (prev && prev.content) previous = Buffer.from(prev.content, 'base64').toString('utf8');\nprevious = previous.replace(/^# Patterns Detected[^\\n]*\\n/, '').slice(0, 20000);\nconst markdown = '# Patterns Detected\\n\\n*Last updated: ' + date + ' (automated, JARVIS Skill 6: Pattern Detector)*\\n\\n## Week ending ' + date + '\\n\\n' + text + '\\n\\n---\\n' + previous;\nreturn [{ json: { path: 'Claude Memory/patterns.md', markdown: markdown, commit: 'Pattern report ' + date + ' (automated)' } }];"
      },
      "id": "pd9",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "edit",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "Claude Memory/patterns.md",
        "fileContent": "={{ $json.markdown }}",
        "commitMessage": "={{ $json.commit }}"
      },
      "id": "pd10",
      "name": "Update Patterns File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1800,
        0
      ]
    }
  ],
  "connections": {
    "Every Monday 8am": {
      "main": [
        [
          {
            "node": "List Inbox",
            "type": "main",
            "index": 0
          }
        ]
