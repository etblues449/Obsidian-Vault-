{
  "name": "JARVIS - Weekly Synthesis",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * 5"
            }
          ]
        }
      },
      "id": "ws1",
      "name": "Every Friday 6pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "list",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "JARVIS/Inbox"
      },
      "id": "ws2",
      "name": "List Inbox",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const N = 30;\nconst files = $input.all().map(i => i.json)\n  .filter(f => f.type === 'file' && String(f.name).endsWith('.md'))\n  .sort((a, b) => String(b.name).localeCompare(String(a.name)))\n  .slice(0, N);\nif (files.length === 0) {\n  return [{ json: { path: 'Claude Memory/capture_queue.md', name: 'capture_queue.md' } }];\n}\nreturn files.map(f => ({ json: { path: f.path, name: f.name } }));"
      },
      "id": "ws3",
      "name": "Pick Recent Captures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "={{ $json.path }}",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "id": "ws4",
      "name": "Get Capture File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const parts = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const name = j.name || j.path || 'file';\n  let text = '';\n  if (j.content) text = Buffer.from(j.content, 'base64').toString('utf8');\n  parts.push('## ' + name + '\\n' + text.slice(0, 4000));\n}\nreturn [{ json: { corpus: parts.join('\\n\\n---\\n\\n').slice(0, 45000) } }];"
      },
      "id": "ws5",
      "name": "Aggregate Captures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const paths = [\n  'Claude Memory/decisions.md',\n  'Claude Memory/beliefs.md',\n  'Claude Memory/patterns.md',\n  'Claude Memory/Projects/Smart Home/_index.md',\n  'Claude Memory/Projects/Faceless Finance/_index.md',\n  'Claude Memory/Projects/Doc to Learning/_index.md',\n  'Claude Memory/Projects/Work Financial Forecasting/_index.md',\n  'Claude Memory/Projects/Other Workspaces/_index.md'\n];\nreturn paths.map(p => ({ json: { path: p, name: p } }));"
      },
      "id": "ws6",
      "name": "Seed Context Paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "={{ $json.path }}",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "id": "ws7",
      "name": "Get Context File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const parts = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const name = j.name || j.path || 'file';\n  let text = '';\n  if (j.content) text = Buffer.from(j.content, 'base64').toString('utf8');\n  parts.push('## ' + name + '\\n' + text.slice(0, 4000));\n}\nreturn [{ json: { corpus: parts.join('\\n\\n---\\n\\n').slice(0, 45000) } }];"
      },
      "id": "ws8",
      "name": "Aggregate Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const captures = $('Aggregate Captures').first().json.corpus;\nconst context = $input.first().json.corpus;\nconst week = $now.setZone('Europe/London');\nconst body = {\n  model: 'claude-opus-4-8',\n  max_tokens: 2500,\n  system: 'You are JARVIS, writing Elliot\\'s weekly synthesis. Sections: ## Momentum (per project), ## Decisions, ## Beliefs Shifted, ## Patterns, ## Blockers Resolved, ## Next Week Priorities (top 3), ## Across Projects. Ground everything in the provided context; if a section has no evidence this week, write \"Nothing logged this week.\" Weight captures from the last 7 days (filenames contain dates). Do not write a top-level # title - start directly with the first ## section.',\n  messages: [{ role: 'user', content: 'Week ' + week.weekNumber + ' of ' + week.weekYear + '.\\n\\n=== THIS WEEK\\'S CAPTURES ===\\n' + captures + '\\n\\n=== PROJECT STATUS + DECISIONS + BELIEFS + PATTERNS ===\\n' + context + '\\n\\nWrite the weekly synthesis.' }]\n};\nreturn [{ json: { body } }];"
      },
      "id": "ws9",
      "name": "Compose Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "ws10",
      "name": "Claude - Synthesize Week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text;\nconst now = $now.setZone('Europe/London');\nconst wk = String(now.weekNumber).padStart(2, '0');\nconst name = now.weekYear + '-W' + wk;\nconst markdown = '# Weekly Synthesis — ' + name + '\\n\\n' + text + '\\n\\n---\\n*Generated automatically by n8n (JARVIS Skill 4: Weekly Synthesis).*\\n';\nreturn [{ json: { path: 'Claude Memory/synthesis/' + name + '.md', markdown: markdown, commit: 'Weekly synthesis ' + name + ' (automated)' } }];"
      },
      "id": "ws11",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "create",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "etblues449"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "Obsidian-Vault-"
        },
        "filePath": "={{ $json.path }}",
        "fileContent": "={{ $json.markdown }}",
        "commitMessage": "={{ $json.commit }}"
      },
      "id": "ws12",
      "name": "Write Synthesis",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [
        2200,
        0
      ]
    }
  ],
