# JARVIS Phone Environment
# Copy to ~/.jarvis/.env and fill in your actual secrets.
# chmod 600 ~/.jarvis/.env (install.sh does this)
# Never commit the real .env to git.

# Anthropic API key (sk-...)
ANTHROPIC_API_KEY=your_api_key_here

# Home Assistant hub URL (LAN IP, no trailing slash)
HA_URL=http://192.168.0.200:8123

# Home Assistant long-lived access token (eyJhbGc...)
HA_TOKEN=your_ha_token_here

# (v2) Optional: Tailscale IP if using remote HA access
# HA_TAILSCALE_IP=100.x.y.z
