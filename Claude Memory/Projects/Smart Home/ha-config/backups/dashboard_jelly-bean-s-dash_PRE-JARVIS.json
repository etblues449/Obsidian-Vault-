{
  "button_card_templates": {
    "jb_room": {
      "show_name": true,
      "show_state": false,
      "show_icon": true,
      "styles": {
        "card": [
          {
            "border-radius": "16px"
          },
          {
            "padding": "12px"
          },
          {
            "background-color": "var(--jb-surface)"
          },
          {
            "box-shadow": "none"
          }
        ],
        "grid": [
          {
            "grid-template-areas": "\"i n\" \"i s\""
          },
          {
            "grid-template-columns": "min-content 1fr"
          }
        ],
        "name": [
          {
            "justify-self": "start"
          },
          {
            "font-weight": 600
          },
          {
            "color": "var(--jb-text)"
          }
        ],
        "icon": [
          {
            "width": "32px"
          },
          {
            "color": "[[[ return states[entity.entity_id].state === 'on'\n    ? 'var(--jb-on)' : 'var(--jb-off)'; ]]]\n"
          }
        ]
      },
      "custom_fields": {
        "s": "[[[\n  var p = variables.presence ? states[variables.presence].state : null;\n  if (p === 'on') return '<span style=\"color:var(--jb-present)\">Occupied</span>';\n  if (p === 'off') return '<span style=\"color:var(--jb-clear)\">Clear</span>';\n  return '<span style=\"color:var(--jb-text-muted)\">\u2014</span>';\n]]]\n"
      }
    }
  },
  "decluttering_templates": {
    "jb_presence_row": {
      "card": {
        "type": "custom:mushroom-template-card",
        "primary": "[[name]]",
        "secondary": "{{ 'Occupied' if is_state('[[presence]]','on') else 'Clear' }}",
        "icon": "{{ 'mdi:motion-sensor' if is_state('[[presence]]','on') else 'mdi:motion-sensor-off' }}",
        "icon_color": "{{ 'var(--jb-present)' if is_state('[[presence]]','on') else 'var(--jb-clear)' }}",
        "tap_action": {
          "action": "more-info"
        }
      }
    },
    "jb_node_card": {
      "card": {
        "type": "custom:mushroom-template-card",
        "primary": "[[name]]",
        "secondary": "{{ states(\"[[wifi]]\") }} dBm",
        "icon": "mdi:wifi",
        "icon_color": "{% set r = states(\"[[wifi]]\")|int(0) %} {{ 'var(--jb-present)' if r > -60 else 'var(--jb-on)' if r > -75 else 'var(--jb-warning)' }}",
        "tap_action": {
          "action": "more-info"
        }
      }
    },
    "jb_light_card": {
      "card": {
        "type": "custom:mushroom-light-card",
        "entity": "[[entity]]",
        "name": "[[name]]",
        "show_brightness_control": true,
        "use_light_color": true,
        "show_color_temp_control": false
      }
    }
  },
  "title": "Jelly Bean's House",
