         "content": "{{ state_attr('climate.ember','current_temperature') | round(1) }}°",
         "icon_color": "orange",
         "tap_action": {
          "action": "more-info"
         }
        },
        {
         "type": "template",
         "entity": "input_boolean.away_mode",
         "icon": "{{ 'mdi:shield-home' if is_state('input_boolean.away_mode','on') else 'mdi:shield-home-outline' }}",
         "content": "Away",
         "icon_color": "{{ 'red' if is_state('input_boolean.away_mode','on') else 'grey' }}",
         "tap_action": {
          "action": "toggle"
         }
        },
        {
         "type": "template",
         "entity": "input_boolean.guest_mode",
         "icon": "mdi:account-group",
         "content": "Guest",
         "icon_color": "{{ 'purple' if is_state('input_boolean.guest_mode','on') else 'grey' }}",
         "tap_action": {
          "action": "toggle"
         }
        }
       ]
      }
     ]
    },
    {
     "type": "grid",
     "column_span": 3,
     "visibility": [
      {
       "condition": "and",
       "conditions": [
        {
         "condition": "state",
         "entity": "input_boolean.away_mode",
         "state": "on"
        },
        {
