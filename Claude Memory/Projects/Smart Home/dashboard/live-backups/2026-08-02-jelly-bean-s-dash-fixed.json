{
 "decluttering_templates": {
  "jb_light": {
   "default": [
    {
     "icon": "mdi:lightbulb"
    }
   ],
   "card": {
    "type": "custom:mushroom-light-card",
    "entity": "[[entity]]",
    "name": "[[name]]",
    "icon": "[[icon]]",
    "layout": "horizontal",
    "use_light_color": true,
    "show_brightness_control": true,
    "show_color_control": true,
    "show_color_temp_control": false,
    "collapsible_controls": true,
    "tap_action": {
     "action": "toggle"
    },
    "hold_action": {
     "action": "more-info"
    }
   }
  },
  "jb_presence": {
   "card": {
    "type": "custom:mushroom-template-card",
    "entity": "[[presence]]",
    "primary": "[[name]]",
    "secondary": "{% if is_state('[[presence]]','on') %}Occupied{% elif is_state('[[presence]]','off') %}Clear{% else %}Offline{% endif %}",
    "icon": "{{ 'mdi:motion-sensor' if is_state('[[presence]]','on') else 'mdi:motion-sensor-off' }}",
    "icon_color": "{% if is_state('[[presence]]','on') %}green{% elif is_state('[[presence]]','off') %}grey{% else %}red{% endif %}",
    "layout": "horizontal",
    "tap_action": {
     "action": "more-info"
    }
   }
  },
  "jb_node": {
   "card": {
    "type": "custom:mushroom-template-card",
    "entity": "[[wifi]]",
    "primary": "[[name]]",
    "secondary": "{% set r = states('[[wifi]]') %}{% if r in ['unknown','unavailable','none',''] %}Offline{% else %}{{ r | int(0) }} dBm{% endif %}",
    "icon": "{% set r = states('[[wifi]]') %}{% if r in ['unknown','unavailable','none',''] %}mdi:wifi-off{% elif r | int(0) > -60 %}mdi:wifi-strength-4{% elif r | int(0) > -70 %}mdi:wifi-strength-3{% elif r | int(0) > -80 %}mdi:wifi-strength-2{% else %}mdi:wifi-strength-1{% endif %}",
    "icon_color": "{% set r = states('[[wifi]]') %}{% if r in ['unknown','unavailable','none',''] %}red{% elif r | int(0) > -70 %}green{% elif r | int(0) > -80 %}amber{% else %}orange{% endif %}",
    "layout": "horizontal",
    "tap_action": {
     "action": "more-info"
    }
   }
  },
  "jb_scene": {
   "card": {
    "type": "custom:mushroom-template-card",
    "primary": "[[name]]",
    "icon": "[[icon]]",
    "icon_color": "[[color]]",
    "layout": "vertical",
    "fill_container": true,
    "tap_action": {
     "action": "perform-action",
     "perform_action": "scene.turn_on",
     "target": {
      "entity_id": "[[scene]]"
     }
    }
   }
  }
 },
 "title": "Jelly Bean's House",
 "views": [
  {
   "title": "Home",
   "path": "home",
   "icon": "mdi:home-variant",
   "type": "sections",
   "max_columns": 3,
   "dense_section_placement": true,
   "theme": "Jelly Bean",
   "sections": [
    {
     "type": "grid",
     "column_span": 3,
     "cards": [
      {
       "type": "custom:mushroom-template-card",
       "primary": "{% set h = now().hour %}{% if h < 5 %}Good night{% elif h < 12 %}Good morning{% elif h < 18 %}Good afternoon{% else %}Good evening{% endif %}, Elliot",
       "secondary": "{% set n = states.light | selectattr('state','eq','on') | list | count %}{% set occ = ['binary_sensor.living_room_kitchen_presence_kitchen_presence','binary_sensor.bedroom_presence','binary_sensor.landing_presence'] | map('states') | select('eq','on') | list | count %}{{ n }} light{{ 's' if n != 1 }} on · {{ occ }} room{{ 's' if occ != 1 }} occupied",
       "icon": "mdi:home-heart",
       "icon_color": "{{ 'blue' if states.light | selectattr('state','eq','on') | list | count > 0 else 'grey' }}",
       "layout": "horizontal",
       "multiline_secondary": true,
       "tap_action": {
        "action": "none"
       }
      },
      {
       "type": "custom:mushroom-chips-card",
       "alignment": "start",
       "chips": [
        {
         "type": "template",
         "entity": "binary_sensor.living_room_kitchen_presence_kitchen_presence",
         "icon": "mdi:sofa",
         "content": "Lounge",
         "icon_color": "{{ 'green' if is_state('binary_sensor.living_room_kitchen_presence_kitchen_presence','on') else 'grey' }}",
         "tap_action": {
          "action": "navigate",
          "navigation_path": "rooms"
         }
        },
        {
         "type": "template",
         "entity": "binary_sensor.bedroom_presence",
         "icon": "mdi:bed",
         "content": "Bedroom",
         "icon_color": "{{ 'green' if is_state('binary_sensor.bedroom_presence','on') else 'grey' }}",
         "tap_action": {
          "action": "navigate",
          "navigation_path": "rooms"
         }
        },
        {
         "type": "template",
         "entity": "binary_sensor.landing_presence",
         "icon": "mdi:stairs",
         "content": "Landing",
         "icon_color": "{{ 'green' if is_state('binary_sensor.landing_presence','on') else 'grey' }}",
         "tap_action": {
          "action": "navigate",
          "navigation_path": "rooms"
         }
        },
        {
         "type": "template",
         "entity": "climate.ember",
