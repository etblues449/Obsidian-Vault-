---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import StatBox from '../components/StatBox.astro';
---

<Layout title="Dashboard">
  <div class="space-y-8">
    <!-- Header -->
    <div>
      <h2 class="text-3xl font-bold text-slate-100">Dashboard</h2>
      <p class="mt-2 text-slate-400">Real-time home automation status and insights</p>
    </div>

    <!-- Key Stats -->
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      <StatBox label="Devices Online" value="12" unit="/" trend="up" />
      <StatBox label="Automations" value="19" unit="active" trend="neutral" />
      <StatBox label="Temperature" value="21.5" unit="°C" trend="neutral" />
      <StatBox label="Energy Usage" value="2.3" unit="kW" trend="down" />
    </div>

    <!-- Rooms Status -->
    <div>
      <h3 class="text-xl font-semibold mb-4 text-slate-100">Room Status</h3>
      <div class="grid gap-4 grid-cols-1 md:grid-cols-3">
        <Card title="Lounge" icon="🛋️" status="active">
          <div class="mt-4 space-y-2 text-sm text-slate-300">
            <p>🌡️ Temperature: 21°C</p>
            <p>💡 Lights: On (80%)</p>
            <p>📺 Media: Standby</p>
          </div>
        </Card>
        <Card title="Bedroom" icon="🛏️" status="online">
          <div class="mt-4 space-y-2 text-sm text-slate-300">
            <p>🌡️ Temperature: 19°C</p>
            <p>💡 Lights: Off</p>
            <p>🚪 Door: Closed</p>
          </div>
        </Card>
        <Card title="Upstairs" icon="🪜" status="online">
          <div class="mt-4 space-y-2 text-sm text-slate-300">
            <p>🌡️ Temperature: 20°C</p>
            <p>💡 Lights: Off</p>
            <p>📡 Sensors: Active</p>
          </div>
        </Card>
      </div>
    </div>

    <!-- Recent Activity -->
    <div>
      <h3 class="text-xl font-semibold mb-4 text-slate-100">Recent Activity</h3>
      <Card title="Activity Log">
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <div class="flex justify-between items-center py-2 border-b border-slate-700">
            <span>🔊 Lounge speaker activated</span>
            <span class="text-xs text-slate-500">2 min ago</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-slate-700">
            <span>🚪 Front door opened</span>
            <span class="text-xs text-slate-500">15 min ago</span>
          </div>
          <div class="flex justify-between items-center py-2 border-b border-slate-700">
            <span>🌙 Bedroom automation triggered</span>
            <span class="text-xs text-slate-500">1 hour ago</span>
          </div>
          <div class="flex justify-between items-center py-2">
            <span>💡 Lounge lights dimmed</span>
            <span class="text-xs text-slate-500">2 hours ago</span>
          </div>
        </div>
      </Card>
    </div>

    <!-- Quick Actions -->
    <div>
      <h3 class="text-xl font-semibold mb-4 text-slate-100">Quick Actions</h3>
      <div class="grid gap-3 grid-cols-2 sm:grid-cols-4">
        <button class="rounded-lg bg-purple-600 hover:bg-purple-700 px-4 py-3 font-semibold transition">
          🏠 All Lights On
        </button>
        <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-4 py-3 font-semibold transition">
          🌙 Bedtime Mode
        </button>
        <button class="rounded-lg bg-slate-700 hover:bg-slate-600 px-4 py-3 font-semibold transition">
          🔐 Lock All
        </button>
        <button class="rounded-lg bg-red-600 hover:bg-red-700 px-4 py-3 font-semibold transition">
          🚨 Emergency
        </button>
      </div>
    </div>
  </div>
</Layout>
