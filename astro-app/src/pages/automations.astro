---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Automations">
  <div class="space-y-8">
    <div>
      <h2 class="text-3xl font-bold text-slate-100">Automations</h2>
      <p class="mt-2 text-slate-400">Manage your home automations</p>
    </div>

    <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
      <Card title="Morning Routine" icon="☀️" status="active">
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <p class="font-semibold">Triggers: 07:00 AM daily</p>
          <div class="space-y-2 text-xs">
            <p>✓ Turn on lounge lights to 80%</p>
            <p>✓ Set bedroom temperature to 22°C</p>
            <p>✓ Play morning news briefing</p>
            <p>✓ Open blinds</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded transition">Edit</button>
            <button class="text-xs bg-red-900 hover:bg-red-800 px-3 py-1 rounded transition">Disable</button>
          </div>
        </div>
      </Card>

      <Card title="Bedtime Mode" icon="🌙" status="active">
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <p class="font-semibold">Triggers: 22:30 PM daily</p>
          <div class="space-y-2 text-xs">
            <p>✓ Dim all lights to 10%</p>
            <p>✓ Close blinds</p>
            <p>✓ Lock all doors</p>
            <p>✓ Arm security system</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded transition">Edit</button>
            <button class="text-xs bg-red-900 hover:bg-red-800 px-3 py-1 rounded transition">Disable</button>
          </div>
        </div>
      </Card>

      <Card title="Presence Away" icon="🚗" status="active">
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <p class="font-semibold">Triggers: All devices leave</p>
          <div class="space-y-2 text-xs">
            <p>✓ Turn off all lights</p>
            <p>✓ Close garage door</p>
            <p>✓ Lock front door</p>
            <p>✓ Set thermostat to eco mode</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded transition">Edit</button>
            <button class="text-xs bg-red-900 hover:bg-red-800 px-3 py-1 rounded transition">Disable</button>
          </div>
        </div>
      </Card>

      <Card title="Movie Time" icon="🎬" status="idle">
        <div class="mt-4 space-y-3 text-sm text-slate-300">
          <p class="font-semibold">Triggers: Manual activation</p>
          <div class="space-y-2 text-xs">
            <p>✓ Dim lounge lights to 5%</p>
            <p>✓ Close blinds</p>
            <p>✓ Activate TV surround sound</p>
            <p>✓ Pause any playing music</p>
          </div>
          <div class="flex gap-2 pt-2">
            <button class="text-xs bg-purple-700 hover:bg-purple-600 px-3 py-1 rounded transition">Activate</button>
            <button class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded transition">Edit</button>
          </div>
        </div>
      </Card>
    </div>

    <div>
      <button class="bg-purple-600 hover:bg-purple-700 px-6 py-3 rounded-lg font-semibold transition">
        + Create New Automation
      </button>
    </div>
  </div>
</Layout>
