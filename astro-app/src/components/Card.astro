---
interface Props {
  title: string;
  icon?: string;
  status?: 'online' | 'offline' | 'idle' | 'active';
}

const { title, icon, status } = Astro.props;

const statusColors = {
  online: 'text-green-400',
  offline: 'text-red-400',
  idle: 'text-yellow-400',
  active: 'text-blue-400',
};
---

<div class="rounded-lg border border-slate-700 bg-slate-800/50 p-6 backdrop-blur hover:border-purple-500 transition">
  <div class="flex items-start justify-between">
    <div>
      <h3 class="text-lg font-semibold text-slate-100">{title}</h3>
      {status && <p class={`text-sm mt-1 ${statusColors[status] || 'text-slate-400'}`}>● {status}</p>}
    </div>
    {icon && <span class="text-3xl">{icon}</span>}
  </div>
  <slot />
</div>
